<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
    <FileVersion major="1" minor="6" />
    <Project>
        <Option title="DarlyRevise" />
        <Option pch_mode="2" />
        <Option compiler="gcc" />
        <Build>
            <Target title="Debug">
                <Option output="engine/DarlyEngine" prefix_auto="1" extension_auto="1" />
                <Option object_output="obj/Debug/" />
                <Option type="1" />
                <Option compiler="gcc" />
                <Compiler>
                    <Add option="-g" />
                    <Add option="-std=c++11" />
                </Compiler>
                <Linker>
                    <Add option="-static-libgcc" />
                    <Add option="-static-libstdc++" />
                </Linker>
            </Target>
            <Target title="Release">
                <Option output="engine/DarlyEngine" prefix_auto="1" extension_auto="1" />
                <Option object_output="obj/Release/" />
                <Option type="1" />
                <Option compiler="gcc" />
                <Compiler>
                    <Add option="-O2" />
                    <Add option="-std=c++11" />
                </Compiler>
            </Target>
        </Build>
        <Unit filename="engine/main.cpp">
            <Option compilerVar="CC" />
        </Unit>
        <Extensions />
    </Project>
</CodeBlocks_project_file>
